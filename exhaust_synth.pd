#X floatatom 150 170 6 0 0 0 - - -;
#X text 50 195 RPM In;
#X text 150 195 Throttle (0~1);
#X obj 50 230 / 60;
#X text 100 230 Rev/sec;
#X obj 50 260 * 4;
#X text 100 260 V8 Fundamental (4 pulses/rev);
#X obj 50 300 phasor~;
#X obj 50 340 bp~ 180 3.5;
#X text 140 340 Helmholtz Muffler Bandpass (180Hz);
#X obj 50 380 lop~ 1500;
